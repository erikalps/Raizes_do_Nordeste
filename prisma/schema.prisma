generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ================= ENUMS =================

enum ResponsavelMetas {
  ADMINISTRADOR
  GERENTE
  AMBOS
}

enum Papel {
  ATENDENTE
  COZINHEIRO
  GERENTE
  ADMINISTRADOR
  CONSULTOR
}

enum Canal {
  APP
  TOTEM
  BALCAO
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  RETIRADO
  CANCELADO
  NAO_RETIRADO
}

enum MotivoCancelamento {
  CLIENTE
  PAGAMENTO_RECUSADO
  PAGAMENTO_SEM_RESPOSTA
  PRAZO_PAGAMENTO_VENCIDO
}

enum StatusPontos {
  PENDENTE
  CONFIRMADO
  DESCARTADO
}

enum FormaPagamento {
  CARTAO
  PIX
  DINHEIRO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  SEM_RESPOSTA
  CANCELADO
  ESTORNADO
}

enum TipoMovimentacao {
  ENTRADA
  PERDA
  RESERVA
  DEVOLUCAO
}

enum PoliticaEstorno {
  REMOVER_PONTOS
  MANTER_PONTOS
}

// ================= UNIDADE E FUNCIONÁRIOS =================

model Unidade {
  id                 String           @id @default(uuid()) @db.Char(36)
  cidade             String           @db.VarChar(100)
  bairro             String           @db.VarChar(100)
  regiao             String           @db.VarChar(50)
  horario_abertura   DateTime         @db.Time(0)
  horario_fechamento DateTime         @db.Time(0)
  ativa              Boolean          @default(false)
  responsavel_metas  ResponsavelMetas

  funcionarios     Funcionario[]
  produtos_unidade ProdutoUnidade[]
  ingredientes     Ingrediente[]
  estoques         EstoqueIngrediente[]
  pedidos          Pedido[]

  @@map("unidade")
}

model Funcionario {
  id                 String    @id @default(uuid()) @db.Char(36)
  unidade_id         String?   @db.Char(36)
  nome               String    @db.VarChar(100)
  papel              Papel
  codigo_hash        String?   @db.VarChar(60)
  ativo              Boolean   @default(true)
  tentativas_erradas Int       @default(0)
  bloqueado_ate      DateTime?

  unidade Unidade? @relation(fields: [unidade_id], references: [id])

  pedidos_registrados    Pedido[]              @relation("pedido_registrado_por")
  pedidos_preparados     Pedido[]              @relation("pedido_preparado_por")
  pedidos_entregues      Pedido[]              @relation("pedido_entregue_por")
  pagamentos_recebidos   Pagamento[]
  movimentacoes          MovimentacaoEstoque[]
  auditorias_executadas  RegistroAuditoria[]   @relation("auditoria_executado_por")
  auditorias_autorizadas RegistroAuditoria[]   @relation("auditoria_autorizado_por")

  @@map("funcionario")
}

// ================= CARDÁPIO =================

model Produto {
  id                           String    @id @default(uuid()) @db.Char(36)
  nome                         String    @db.VarChar(100)
  preco_base                   Decimal   @db.Decimal(10, 2)
  travado                      Boolean   @default(false)
  permite_alterar_ingredientes Boolean   @default(false)
  permite_alterar_preco        Boolean   @default(false)
  faixa_preco_percentual       Decimal?  @db.Decimal(5, 2)
  sazonal                      Boolean   @default(false)
  inicio_janela                DateTime? @db.Date
  fim_janela                   DateTime? @db.Date

  produtos_unidade ProdutoUnidade[]
  itens_receita    ItemReceita[]
  itens_pedido     ItemPedido[]

  @@map("produto")
}

model ProdutoUnidade {
  id            String   @id @default(uuid()) @db.Char(36)
  produto_id    String   @db.Char(36)
  unidade_id    String   @db.Char(36)
  oferecido     Boolean  @default(true)
  preco_unidade Decimal? @db.Decimal(10, 2)
  sazonal_ativo Boolean  @default(false)

  produto Produto @relation(fields: [produto_id], references: [id])
  unidade Unidade @relation(fields: [unidade_id], references: [id])

  @@unique([produto_id, unidade_id])
  @@map("produto_unidade")
}

// ================= ESTOQUE =================

model Ingrediente {
  id             String  @id @default(uuid()) @db.Char(36)
  unidade_id     String? @db.Char(36)
  nome           String  @db.VarChar(100)
  unidade_medida String  @db.VarChar(20)
  regional       Boolean @default(false)

  unidade Unidade? @relation(fields: [unidade_id], references: [id])

  itens_receita ItemReceita[]
  estoques      EstoqueIngrediente[]

  @@map("ingrediente")
}

model ItemReceita {
  id             String  @id @default(uuid()) @db.Char(36)
  produto_id     String  @db.Char(36)
  ingrediente_id String  @db.Char(36)
  quantidade     Decimal @db.Decimal(10, 3)
  trocavel       Boolean @default(false)

  produto     Produto     @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingrediente_id], references: [id])

  @@unique([produto_id, ingrediente_id])
  @@map("item_receita")
}

model EstoqueIngrediente {
  id                String  @id @default(uuid()) @db.Char(36)
  unidade_id        String  @db.Char(36)
  ingrediente_id    String  @db.Char(36)
  quantidade        Decimal @db.Decimal(10, 3)
  quantidade_minima Decimal @db.Decimal(10, 3)

  unidade     Unidade     @relation(fields: [unidade_id], references: [id])
  ingrediente Ingrediente @relation(fields: [ingrediente_id], references: [id])

  movimentacoes MovimentacaoEstoque[]

  @@unique([unidade_id, ingrediente_id])
  @@map("estoque_ingrediente")
}

model MovimentacaoEstoque {
  id                     String           @id @default(uuid()) @db.Char(36)
  estoque_ingrediente_id String           @db.Char(36)
  funcionario_id         String?          @db.Char(36)
  pedido_id              String?          @db.Char(36)
  tipo                   TipoMovimentacao
  quantidade             Decimal          @db.Decimal(10, 3)
  motivo                 String?          @db.VarChar(255)
  criado_em              DateTime         @default(now())

  estoque     EstoqueIngrediente @relation(fields: [estoque_ingrediente_id], references: [id])
  funcionario Funcionario?       @relation(fields: [funcionario_id], references: [id])
  pedido      Pedido?            @relation(fields: [pedido_id], references: [id])

  @@map("movimentacao_estoque")
}

// ================= CLIENTE E FIDELIDADE =================

model Cliente {
  id              String   @id @default(uuid()) @db.Char(36)
  /// Criptografado no código antes de salvar
  cpf             String   @db.Text
  cpf_hash        String   @unique @db.Char(64)
  /// Criptografado no código antes de salvar
  email           String   @db.Text
  /// Criptografado no código antes de salvar
  celular         String   @db.Text
  saldo_pontos    Int      @default(0)
  /// Criptografado no código antes de salvar
  data_nascimento String?  @db.Text
  criado_em       DateTime @default(now())

  pedidos Pedido[]

  @@map("cliente")
}

model ConfiguracaoFidelidade {
  id               String          @id @default(uuid()) @db.Char(36)
  pontos_por_real  Decimal         @db.Decimal(10, 2)
  valor_ponto      Decimal         @db.Decimal(10, 4)
  politica_estorno PoliticaEstorno

  @@map("configuracao_fidelidade")
}

// ================= PEDIDO =================

model Pedido {
  id                  String              @id @default(uuid()) @db.Char(36)
  unidade_id          String              @db.Char(36)
  cliente_id          String?             @db.Char(36)
  registrado_por_id   String?             @db.Char(36)
  preparado_por_id    String?             @db.Char(36)
  entregue_por_id     String?             @db.Char(36)
  numero_retirada     String?             @db.VarChar(10)
  canal_pedido        Canal
  status              StatusPedido
  motivo_cancelamento MotivoCancelamento?
  valor_bruto         Decimal             @db.Decimal(10, 2)
  desconto_nivel      Decimal             @default(0) @db.Decimal(10, 2)
  desconto_pontos     Decimal             @default(0) @db.Decimal(10, 2)
  valor_pago          Decimal             @db.Decimal(10, 2)
  pontos_ganhos       Int                 @default(0)
  pontos_usados       Int                 @default(0)
  status_pontos       StatusPontos?
  criado_em           DateTime            @default(now())
  pago_em             DateTime?
  preparo_iniciado_em DateTime?
  pronto_em           DateTime?
  finalizado_em       DateTime?

  unidade        Unidade      @relation(fields: [unidade_id], references: [id])
  cliente        Cliente?     @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  registrado_por Funcionario? @relation("pedido_registrado_por", fields: [registrado_por_id], references: [id])
  preparado_por  Funcionario? @relation("pedido_preparado_por", fields: [preparado_por_id], references: [id])
  entregue_por   Funcionario? @relation("pedido_entregue_por", fields: [entregue_por_id], references: [id])

  itens         ItemPedido[]
  pagamentos    Pagamento[]
  movimentacoes MovimentacaoEstoque[]

  @@map("pedido")
}

model ItemPedido {
  id             String  @id @default(uuid()) @db.Char(36)
  pedido_id      String  @db.Char(36)
  produto_id     String  @db.Char(36)
  quantidade     Int
  preco_unitario Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produto_id], references: [id])

  @@map("item_pedido")
}

model Pagamento {
  identificador_tentativa String          @id @default(uuid()) @db.Char(36)
  pedido_id               String          @db.Char(36)
  recebido_por_id         String?         @db.Char(36)
  forma                   FormaPagamento
  status                  StatusPagamento
  valor                   Decimal         @db.Decimal(10, 2)
  motivo_recusa           String?         @db.VarChar(255)
  criado_em               DateTime        @default(now())
  expira_em               DateTime
  respondido_em           DateTime?

  pedido       Pedido       @relation(fields: [pedido_id], references: [id])
  recebido_por Funcionario? @relation(fields: [recebido_por_id], references: [id])

  @@map("pagamento")
}

// ================= AUDITORIA =================

model RegistroAuditoria {
  id                String   @id @default(uuid()) @db.Char(36)
  executado_por_id  String?  @db.Char(36)
  autorizado_por_id String?  @db.Char(36)
  acao              String   @db.VarChar(50)
  entidade          String   @db.VarChar(50)
  entidade_id       String   @db.VarChar(36)
  motivo            String?  @db.VarChar(255)
  valor_anterior    String?  @db.Text
  valor_novo        String?  @db.Text
  criado_em         DateTime @default(now())

  executado_por  Funcionario? @relation("auditoria_executado_por", fields: [executado_por_id], references: [id])
  autorizado_por Funcionario? @relation("auditoria_autorizado_por", fields: [autorizado_por_id], references: [id])

  @@map("registro_auditoria")
}
