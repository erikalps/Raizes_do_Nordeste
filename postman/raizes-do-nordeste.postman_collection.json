                  "pm.test(\"Aguardando pagamento\", () => pm.expect(json.status).to.eql(\"AGUARDANDO_PAGAMENTO\"));",
                  "pm.test(\"Total calculado pelo servidor\", () => pm.expect(json.total).to.eql(\"28.00\"));",
                  "pm.test(\"Tentativa de pagamento pendente\", () => pm.expect(json.pagamento.status).to.eql(\"PENDENTE\"));",
                  "pm.collectionVariables.set(\"pedidoId\", json.pedidoId);",
                  "pm.collectionVariables.set(\"tentativaId\", json.pagamento.identificadorTentativa);"
                ]
