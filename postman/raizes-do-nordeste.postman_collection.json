            "body": {
              "mode": "raw",
              "raw": "{\n  \"funcionarioId\": \"{{gerenteId}}\",\n  \"codigo\": \"1111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Token do tipo Bearer\", () => pm.expect(json.tokenType).to.eql(\"Bearer\"));",
