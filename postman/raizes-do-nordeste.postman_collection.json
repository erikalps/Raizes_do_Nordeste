                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const ovo = json.data.find((p) => p.nome === \"Cuscuz com ovo\");",
                  "pm.test(\"Cuscuz com ovo indisponível (sem ovo no estoque)\", () => pm.expect(ovo.disponivel).to.eql(false));",
                  "const queijo = json.data.find((p) => p.nome === \"Tapioca de queijo coalho\");",
                  "pm.test(\"Tapioca de queijo disponível\", () => pm.expect(queijo.disponivel).to.eql(true));"
                ]
              }
            }
          ]
        }
